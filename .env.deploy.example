MYSQL_PASSWORD=REPLACE_WITH_APP_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_ROOT_DB_PASSWORD
DEMO_PASSWORD=REPLACE_WITH_LONG_DEMO_PASSWORD

# Nur auf der Azure-VM: Etappe A (HTTP) und Etappe B (Caddy).
