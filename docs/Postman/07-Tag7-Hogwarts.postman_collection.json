                  " pm.expect(rows.length).to.eql(2);",
                  " pm.expect(rows.map(r => r.student_id)).to.deep.equal([",
                  "  Number(pm.collectionVariables.get(\"harry_id\")), Number(pm.collectionVariables.get(\"ron_id\"))]);",
                  " rows.forEach(r => {",
                  "  pm.expect(r.course_id).to.eql(Number(pm.collectionVariables.get(\"created_course_id\")));",
                  "  pm.expect(r.booking_date).to.eql(\"1993-09-06\");",
                  " });",
                  " pm.expect(rows[0].id).not.to.eql(rows[1].id);",
                  " pm.collectionVariables.set(\"booking_one_id\", rows[0].id);",
                  " pm.collectionVariables.set(\"booking_two_id\", rows[1].id);",
                  "});"
