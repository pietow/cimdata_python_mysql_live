    {
      "name": "02 - Berichte vergleichen",
      "item": [
        {
          "name": "Sync: erste Seite als Referenz",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reports/bookings?booking_date={{report_date}}&limit=2&after_id=0",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vector_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const rows = pm.response.json();",
                  "  pm.test('Nichtleerer Berichtstag, höchstens zwei Zeilen', () => {",
                  "    pm.expect(rows.length).to.be.within(1, 2);",
                  "  });",
                  "  pm.collectionVariables.set('report_reference',",
                  "    JSON.stringify(rows));",
                  "  pm.collectionVariables.set('reference_day',",
                  "    pm.collectionVariables.get('report_date'));",
                  "  pm.collectionVariables.set('report_after_id',",
                  "    rows.length ? String(rows[rows.length - 1].id) : '0');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Async: erste Seite vergleichen",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/async/reports/bookings?booking_date={{report_date}}&limit=2&after_id=0",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vector_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Gleicher Tag und vollständige Antwort', () => {",
                  "    pm.expect(pm.collectionVariables.get('reference_day'))",
                  "      .to.eql(pm.collectionVariables.get('report_date'));",
                  "    const rows = pm.response.json();",
                  "    pm.expect(rows.length).to.be.greaterThan(0);",
                  "    pm.expect(rows).to.deep.eql(JSON.parse(",
                  "      pm.collectionVariables.get('report_reference')));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync: zweite Seite als Referenz",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reports/bookings?booking_date={{report_date}}&limit=2&after_id={{report_after_id}}",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vector_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('second_reference',",
                  "    JSON.stringify(pm.response.json()));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Async: zweite Seite vergleichen",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/async/reports/bookings?booking_date={{report_date}}&limit=2&after_id={{report_after_id}}",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vector_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Gleiche zweite Seite ohne wiederholte IDs', () => {",
                  "    const rows = pm.response.json();",
                  "    pm.expect(rows).to.deep.eql(JSON.parse(",
                  "      pm.collectionVariables.get('second_reference')));",
                  "    const first = JSON.parse(",
                  "      pm.collectionVariables.get('report_reference'));",
                  "    const ids = first.map(row => row.id);",
                  "    pm.expect(rows.every(row => !ids.includes(row.id))).eql(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
