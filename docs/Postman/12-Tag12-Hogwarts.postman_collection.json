  "item": [
    {
      "name": "Demo - Threads und Async vergleichen",
      "description": "Abschnitt 2 des Dozentenskripts. Öffentliche Demo-Routen auf Port 8001, ohne Anmeldung. Jede Route wartet 0,4 s. Einzelnes Send: jeweils ungefähr gleiche Wartezeit. Nebenläufigkeit: Run > Performance, lokal/App, Fixed, 5 virtuelle Nutzer, 1 Minute. Pro Lauf NUR EINEN der drei Requests auswählen; für die anderen Varianten getrennt wiederholen. Durchsatz (Requests/s) und Antwortzeit vergleichen. Blocking: weniger Durchsatz; thread und cooperative: höherer, oft ähnlicher Durchsatz. Der normale funktionale Runner sendet nacheinander. Der Performance-Modus wiederholt Anfragen während der Testdauer, statt nur fünf Anfragen einmal zu senden. Keine Auth-, Berichts- oder Bonus-Requests mitmessen. Ein Worker, kein Reload. Diese kleine Demo zeigt noch keine Threadpool-Grenze.",
      "item": [
        {
          "name": "Blocking: Event Loop blockiert",
          "request": {
            "method": "GET",
            "url": "{{demo_base_url}}/waiting/blocking",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "description": "async def mit time.sleep(0.4). Blockiert den Event Loop des Demo-Dienstes. Für den Performance-Vergleich nur diesen Request auswählen."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 und Modus blocking', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.deep.eql({mode: 'blocking'});",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Thread: Warten im Threadpool",
          "request": {
            "method": "GET",
            "url": "{{demo_base_url}}/waiting/thread",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "description": "def mit time.sleep(0.4). Jeder laufende Aufruf belegt einen Threadpool-Platz. Für den Performance-Vergleich nur diesen Request auswählen."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 und Modus thread', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.deep.eql({mode: 'thread'});",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cooperative: Warten gibt Event Loop frei",
          "request": {
            "method": "GET",
            "url": "{{demo_base_url}}/waiting/cooperative",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "description": "async def mit await asyncio.sleep(0.4). Während eine Task wartet, kann der Event Loop andere Tasks bearbeiten. Für den Performance-Vergleich nur diesen Request auswählen."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 und Modus cooperative', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.deep.eql({mode: 'cooperative'});",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
