        {
          "name": "vector: anmelden",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"vector\",\n  \"password\": \"{{vector_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Bearer-Token vorhanden', () => {",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "  });",
                  "  pm.collectionVariables.set('vector_token', body.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "reader: anmelden",
          "request": {
