                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "// Aufräumen: widerrufene Tokens lokal leeren.",
                  "pm.collectionVariables.set('staff_token', '');",
                  "pm.collectionVariables.set('reader_token', '');",
                  "pm.collectionVariables.set('hagrid_token', '');"
                ]
              }
