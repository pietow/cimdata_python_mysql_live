{
  "info": {
    "name": "Tag 13 – Etappe B: HTTPS mit Caddy",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Zum Dozentenskript Tag 13, Abschnitt 7.5. Prüft die API auf der Azure-VM hinter Caddy. Vorher: base_url auf https://NAME.REGION.cloudapp.azure.com setzen (ohne Schrägstrich am Ende) und in den drei Login-Requests REPLACE_WITH_LONG_DEMO_PASSWORD durch DEMO_PASSWORD aus .env.deploy der VM ersetzen. Ordner 00–04 nacheinander ausführen, z. B. mit dem Collection Runner. Ordner 03 legt bei jedem Lauf einen neuen Kurs an; seine ID steht danach in cloud_course_id und wird in Abschnitt 8 nach dem Update erneut gelesen. Kein Request löscht Daten. Nach Abschnitt 8 expected_version auf 0.9.1 setzen. Nach Abschluss Passwörter in den Login-Bodies und Tokens leeren; keine befüllten Exporte teilen."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://hogwarts-deinname.germanywestcentral.cloudapp.azure.com",
      "type": "string"
    },
    {
      "key": "expected_version",
      "value": "0.9.0",
      "type": "string"
    },
    {
      "key": "staff_username",
      "value": "vector",
      "type": "string"
    },
    {
      "key": "reader_username",
      "value": "babbling",
      "type": "string"
    },
    {
      "key": "staff_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "hagrid_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reader_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "other_course_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "cloud_course_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 – HTTPS und Erreichbarkeit",
      "item": [
        {
          "name": "Health über HTTPS",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "description": "Gültiges Zertifikat vorausgesetzt: Postman bricht sonst mit einem SSL-Fehler ab.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Aufruf lief über HTTPS', function () {",
                  "  pm.expect(pm.request.url.protocol).to.eql('https');",
                  "});",
                  "pm.test('Health', function () {",
                  "  pm.expect(pm.response.json()).to.eql({status: 'ok'});",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Version",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/version",
            "description": "Zeigt, welcher Code im Container läuft. Nach Abschnitt 8 expected_version auf 0.9.1 setzen.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Erwartete Version', function () {",
                  "  pm.expect(pm.response.json().version)",
                  "    .to.eql(pm.variables.get('expected_version'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HTTP leitet auf HTTPS um",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{http_url}}/health",
            "description": "Ruft dieselbe Adresse mit http:// auf. Umleitungen folgt Postman hier bewusst nicht.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// http_url aus base_url ableiten: nur das Schema ändert sich.",
                  "const httpUrl = pm.variables.get('base_url').replace(/^https:/, 'http:');",
                  "pm.variables.set('http_url', httpUrl);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Umleitung (308)', function () {",
                  "  pm.response.to.have.status(308);",
                  "});",
                  "pm.test('Ziel ist dieselbe Adresse mit https', function () {",
                  "  const target = pm.variables.get('base_url') + '/health';",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql(target);",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Kurse ohne Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/courses",
            "description": "HTTPS ersetzt keine Anmeldung.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Bearer-Challenge', function () {",
                  "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 – Anmeldung",
      "item": [
        {
          "name": "Login vector",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "REPLACE_WITH_LONG_DEMO_PASSWORD im Body durch DEMO_PASSWORD aus .env.deploy ersetzen. Das Token wird in staff_token gespeichert.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"vector\",\n  \"password\": \"REPLACE_WITH_LONG_DEMO_PASSWORD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Token erhalten', function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.access_token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('staff_token', data.access_token);",
                  "});",
                  "pm.test('Antwort wird nicht zwischengespeichert', function () {",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
                  "});"
                ]
              }
            }
          ]
        },
