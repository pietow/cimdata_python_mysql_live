        {
          "name": "Wer bin ich? (Staff)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staff_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Rolle staff', function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.username).to.eql(pm.variables.get('staff_username'));",
                  "  pm.expect(data.role).to.eql('staff');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
