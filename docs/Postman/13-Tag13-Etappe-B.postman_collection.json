        {
          "name": "Login babbling",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "REPLACE_WITH_LONG_DEMO_PASSWORD im Body durch DEMO_PASSWORD aus .env.deploy ersetzen. Das Token wird in reader_token gespeichert.",
            "auth": {
              "type": "noauth"
