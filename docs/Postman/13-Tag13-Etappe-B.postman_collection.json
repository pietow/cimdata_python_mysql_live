            "description": "REPLACE_WITH_LONG_DEMO_PASSWORD im Body durch DEMO_PASSWORD aus .env.deploy ersetzen. Das Token wird in hagrid_token gespeichert.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"hagrid\",\n  \"password\": \"REPLACE_WITH_LONG_DEMO_PASSWORD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Token erhalten', function () {",
                  "  const data = pm.response.json();",
