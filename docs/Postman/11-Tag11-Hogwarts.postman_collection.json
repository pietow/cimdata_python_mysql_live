                "value": "Bearer {{vector_token}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Auch nach einem Abbruch hier verbliebene Token widerrufen. 401 bedeutet: kein gültiges Token mehr."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Abgemeldet oder bereits ungültig', function () { pm.expect([204, 401].includes(pm.response.code)).to.eql(true); });",
