        {
          "name": "vector: anmelden",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{{login_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('vector_token')) { throw new Error('Vor erneutem Login das vorhandene Token in Ordner 03 abmelden.'); }",
                  "const password = pm.collectionVariables.get('vector_password');",
                  "if (!password) { throw new Error('Lokales Passwort für vector eintragen.'); }",
                  "pm.variables.set('login_body', JSON.stringify({username: 'vector', password: password}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.json().access_token;",
                  "  pm.test('Token erhalten', function () { pm.expect(typeof token).to.eql('string'); pm.expect(token.length > 0).to.eql(true); });",
                  "  pm.collectionVariables.set('vector_token', token);",
                  "}"
                ]
              }
            }
          ]
