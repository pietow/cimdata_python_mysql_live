    {
      "name": "01 – Tagesbericht und Seiten",
      "description": "Erste Berichtsseite zuerst ausführen, dann Folgeseite und Hagrids Bericht. Ein Tag ohne Treffer liefert korrekt []. Die vollständige Rechtetrennung prüfen zusätzlich die Tests mit festen Daten.",
      "item": [
        {
          "name": "Vector: erste Berichtsseite",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reports/bookings?booking_date={{report_date}}&limit=2&after_id=0",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vector_token}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Vorher report_date auf einen vorhandenen Berichtstag setzen. Speichert die letzte ID automatisch. Bei Datumswechsel diese Anfrage erneut ausführen."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const rows = pm.response.json();",
                  "  pm.test('Höchstens zwei Zeilen am gewählten Tag', function () {",
                  "    pm.expect(Array.isArray(rows)).to.eql(true);",
                  "    pm.expect(rows.length <= 2).to.eql(true);",
                  "    pm.expect(rows.every(row => row.booking_date === pm.collectionVariables.get('report_date'))).to.eql(true);",
                  "  });",
                  "  pm.test('Öffentliche Berichtsfelder', function () {",
                  "    rows.forEach(row => pm.expect(row).to.have.keys('id', 'student_name', 'course_title', 'booking_date'));",
                  "  });",
                  "  pm.collectionVariables.set('first_page_ids', JSON.stringify(rows.map(row => row.id)));",
                  "  // Wie ein Frontend: letzte ID merken und bei der Folgeanfrage mitsenden.",
                  "  pm.collectionVariables.set('report_after_id', rows.length ? String(rows[rows.length - 1].id) : '0');",
                  "  pm.collectionVariables.set('page_day', pm.collectionVariables.get('report_date'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Vector: nächste Berichtsseite",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reports/bookings?booking_date={{page_day}}&limit=2&after_id={{report_after_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vector_token}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Verwendet Datum und letzte ID der ersten Antwort. Kein manuelles Berechnen der nächsten ID."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('page_day')) { throw new Error('Zuerst die erste Berichtsseite abrufen.'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const rows = pm.response.json();",
                  "  const after = Number(pm.collectionVariables.get('report_after_id'));",
                  "  const firstIds = JSON.parse(pm.collectionVariables.get('first_page_ids') || '[]');",
                  "  pm.test('Seite setzt hinter der letzten ID fort', function () {",
                  "    pm.expect(rows.length <= 2).to.eql(true);",
                  "    pm.expect(rows.every(row => row.id > after && !firstIds.includes(row.id))).to.eql(true);",
                  "    pm.expect(rows.every(row => row.booking_date === pm.collectionVariables.get('page_day'))).to.eql(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Hagrid: eigener Bericht",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reports/bookings?booking_date={{report_date}}&limit=20",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hagrid_token}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const firstIds = JSON.parse(pm.collectionVariables.get('first_page_ids') || '[]');",
                  "  pm.test('Hagrid erhält keine IDs aus Vectors geprüfter Seite', function () {",
                  "    pm.expect(pm.response.json().every(row => !firstIds.includes(row.id))).to.eql(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
