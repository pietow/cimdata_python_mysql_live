                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Öffentliche Identität', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.all.keys('id', 'username', 'role');",
                  "  pm.expect(body.role).to.eql('reader');",
