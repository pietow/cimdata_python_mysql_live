                "type": "text/javascript",
                "exec": [
                  "// Ein JavaScript-Objekt wird korrekt als JSON serialisiert.",
                  "// Auch Anführungszeichen und Backslashes im Passwort bleiben erhalten.",
                  "const body = {",
                  "  username: pm.variables.get('reader_username'),",
                  "  password: pm.variables.get('reader_password')",
                  "};",
                  "pm.collectionVariables.unset('reader_token'); // Kein altes Token weiterverwenden.",
                  "pm.variables.set('tag9_login_body', JSON.stringify(body));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Tokenvertrag', function () {",
                  "    pm.expect(body.token_type).to.eql('bearer');",
                  "    pm.expect(body.expires_in).to.eql(1800);",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(pm.response.headers.get('Cache-Control'))",
                  "      .to.eql('no-store');",
                  "  });",
                  "  pm.collectionVariables.set('reader_token', body.access_token);",
                  "}"
                ]
              }
            }
